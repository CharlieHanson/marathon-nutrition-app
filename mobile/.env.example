# Mobile (Expo) — copy values into `mobile/.env` for local `expo start`.
# For EAS cloud builds, set these as EAS secrets / project env — EXPO_PUBLIC_*
# from local .env are NOT included in EAS builds automatically.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin of the standalone Express API (Render). No trailing slash.
# Required — the app will throw at startup if this is missing.
EXPO_PUBLIC_API_URL=https://your-api-service.onrender.com

# Web app origin for auth email redirects (/auth/callback, /update-password).
# This is the Next.js site, NOT the Express API.
EXPO_PUBLIC_SITE_URL=https://alimentanutrition.com

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# PostHog product analytics. Defaults to disabled in local dev; used in production builds.
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring. Optional locally; set in EAS for production builds.
SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000

# Sentry source map upload token for EAS builds. Never expose this in app code.
SENTRY_AUTH_TOKEN=sntrys_your_auth_token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-mobile-sentry-project-slug
