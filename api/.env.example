# ---------------------------------------------------------------------------
# nutrition-api environment variables
# Copy to `.env` for local development (do NOT commit the real .env).
# NOTE: This service intentionally uses NON-prefixed vars. Do not reuse the
# NEXT_PUBLIC_* names from the Next.js frontend here.
# ---------------------------------------------------------------------------

# Supabase (server-side / admin access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional fallback used when the service role key is absent
SUPABASE_ANON_KEY=your-anon-key

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=your-gemini-key

# ML prediction service (macro estimation)
ML_API_URL=https://alimenta-ml-service.onrender.com

# CORS: comma-separated list of allowed origins.
# Example: https://app.example.com,https://admin.example.com
# Leave empty to allow all origins (local dev only).
CORS_ORIGINS=

# HTTP port the service listens on
PORT=4000
