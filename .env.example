# Web (Next.js) — copy to `.env.local` for local development.
# Do NOT commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin of the standalone Express API (Render). No trailing slash.
# Required — the web app will throw at startup if this is missing.
NEXT_PUBLIC_API_URL=https://your-api-service.onrender.com

# Optional / local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ML_API_URL=https://alimenta-ml-service.onrender.com

# Server-side secrets are no longer needed on Vercel for meal APIs
# (those live on the Express service). Keep Supabase anon keys for the browser client.
